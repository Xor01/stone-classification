ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://cvuser:cvpassword@postgres:5432/cvapp

# Relative to the process CWD, which is `backend/` for local `uv run uvicorn`
# and `/app` in the container. The model ships beside the app code in both.
MODEL_PATH=app/models/model.pt
LABELS_PATH=app/models/labels.json
MODEL_VERSION=1.0.0

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_UPLOAD_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Langfuse Observability & Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

