ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://cvuser:cvpassword@postgres:5432/cvapp

# /app/models/... is correct INSIDE Docker (WORKDIR /app, models/ gets
# copied or volume-mounted there). Running locally with `uv run uvicorn`
# from inside backend/, use relative paths pointing at the repo-root
# models/ folder instead:
#   MODEL_PATH=../models/model.pt
#   LABELS_PATH=../models/labels.json
MODEL_PATH=../models/model.pt
LABELS_PATH=../models/labels.json
MODEL_VERSION=1.0.0

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_UPLOAD_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
